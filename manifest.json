{
    "manifest_version": 3,
    "name": "SURF",
    "version": "1.1.0",
    "description": "AI가 DGA·악성 도메인을 실시간 판별해 접속을 차단하고, 오탐은 사용자가 직접 되돌릴 수 있는 보안 확장입니다.",
    "permissions": [
        "webRequest",
        "webNavigation",
        "storage",
        "tabs"
    ],
    "host_permissions": [
        "<all_urls>"
    ],
    "background": {
        "service_worker": "background.js",
        "type": "module"
    },
    "icons": {
        "16": "icons/logo.png",
        "48": "icons/logo.png",
        "128": "icons/logo128.png"
    },
    "action": {
        "default_icon": {
            "16": "icons/logo.png",
            "48": "icons/logo.png",
            "128": "icons/logo128.png"
        }
    }
}
